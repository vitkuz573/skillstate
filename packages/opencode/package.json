{
  "name": "@skillstate/opencode",
  "version": "2.2.2",
  "description": "OpenCode platform adapter for the skillstate runtime.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
