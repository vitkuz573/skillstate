{
  "name": "@skillstate/mcp",
  "version": "3.0.1",
  "description": "MCP server + adapter for the skillstate runtime: schema-typed execution state for long-horizon agents (SKILL.state, arXiv:2608.26263).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "skillstate-mcp": "bin/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@skillstate/core": "^3.0.0"
  }
}
