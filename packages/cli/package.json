{
  "name": "@skillstate/cli",
  "version": "2.2.0",
  "description": "skillstate CLI — init | run | report.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "skillstate": "bin/skillstate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@skillstate/codex": "^2.0.0",
    "@skillstate/core": "^2.0.0",
    "@skillstate/mcp": "^2.0.0",
    "@skillstate/opencode": "^2.0.0"
  }
}
